{
  "apiVersion": 1,
  "id": "api-scratch",
  "name": "API Scratchpad",
  "version": "1.3.1",
  "description": "A Postman-lite HTTP scratchpad for Minnow: send requests with saved defaults and auth, browse responses, keep request collections and named environments, and drive it all from chat.",
  "tools": [
    {
      "id": "http_request",
      "description": "Send an HTTP request. Applies the saved defaults and auth from the plugin connection, substitutes {{variable}} placeholders from a named environment, times the response, and returns status, headers and a truncated body.",
      "handler": "http_request.mjs",
      "timeoutMs": 120000,
      "parameters": {
        "type": "object",
        "properties": {
          "url": { "type": "string", "description": "Absolute URL, or a path resolved against the configured base URL." },
          "method": { "type": "string", "description": "HTTP method (default GET)." },
          "headers": {
            "description": "Extra headers as an object map, or an array of {key,value,enabled}.",
            "oneOf": [
              { "type": "object" },
              { "type": "array", "items": { "type": "object" } }
            ]
          },
          "body": { "type": "string", "description": "Request body for non-GET/HEAD methods." },
          "content_type": { "type": "string", "description": "Content-Type to set if one is not already provided." },
          "environment": { "type": "string", "description": "Named environment to resolve {{variables}} from (defaults to the active one)." },
          "timeout_ms": { "type": "integer", "minimum": 1000, "maximum": 120000, "description": "Request timeout in milliseconds (default 30000)." }
        },
        "required": ["url"],
        "additionalProperties": false
      }
    },
    {
      "id": "http_list_collections",
      "description": "List saved request collections with their item counts.",
      "handler": "http_list_collections.mjs",
      "parameters": { "type": "object", "properties": {}, "additionalProperties": false }
    },
    {
      "id": "http_get_collection",
      "description": "Return one saved collection with all of its requests.",
      "handler": "http_get_collection.mjs",
      "parameters": {
        "type": "object",
        "properties": { "id": { "type": "string", "description": "Collection id." } },
        "required": ["id"],
        "additionalProperties": false
      }
    },
    {
      "id": "http_save_collection",
      "description": "Create or update a request collection (and optionally replace its items).",
      "handler": "http_save_collection.mjs",
      "parameters": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "Existing collection id to update (optional)." },
          "name": { "type": "string", "description": "Collection name." },
          "items": { "type": "array", "items": { "type": "object" }, "description": "Collection requests to store." }
        },
        "required": ["name"],
        "additionalProperties": false
      }
    },
    {
      "id": "http_delete_collection",
      "description": "Delete a saved request collection by id.",
      "handler": "http_delete_collection.mjs",
      "parameters": {
        "type": "object",
        "properties": { "id": { "type": "string", "description": "Collection id." } },
        "required": ["id"],
        "additionalProperties": false
      }
    },
    {
      "id": "http_run_collection_item",
      "description": "Fire one saved request from a collection by id.",
      "handler": "http_run_collection_item.mjs",
      "timeoutMs": 120000,
      "parameters": {
        "type": "object",
        "properties": {
          "collection_id": { "type": "string", "description": "Collection id." },
          "item_id": { "type": "string", "description": "Request id inside the collection." },
          "environment": { "type": "string", "description": "Environment override for this run." },
          "timeout_ms": { "type": "integer", "minimum": 1000, "maximum": 120000 }
        },
        "required": ["collection_id", "item_id"],
        "additionalProperties": false
      }
    },
    {
      "id": "http_list_environments",
      "description": "List named environments ({{variable}} sets) and which one is active.",
      "handler": "http_list_environments.mjs",
      "parameters": { "type": "object", "properties": {}, "additionalProperties": false }
    },
    {
      "id": "http_save_environment",
      "description": "Create or update a named environment of {{variable}} values, optionally making it active.",
      "handler": "http_save_environment.mjs",
      "parameters": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "description": "Environment name." },
          "vars": { "type": "object", "description": "Map of variable name to value." },
          "active": { "type": "boolean", "description": "Make this the active environment." }
        },
        "required": ["name"],
        "additionalProperties": false
      }
    }
  ],
  "connections": [
    {
      "id": "defaults",
      "label": "Request defaults",
      "fields": [
        { "id": "base_url", "label": "Base URL (used for relative paths)", "secret": false, "required": false },
        { "id": "default_headers", "label": "Default headers (one 'Name: value' per line)", "secret": false, "required": false },
        { "id": "auth_type", "label": "Auth type (none | bearer | basic)", "secret": false, "required": false },
        { "id": "bearer_token", "label": "Bearer token", "secret": true, "required": false },
        { "id": "username", "label": "Basic auth username", "secret": false, "required": false },
        { "id": "password", "label": "Basic auth password", "secret": true, "required": false }
      ]
    }
  ],
  "ui": { "entry": "ui.mjs" }
}
