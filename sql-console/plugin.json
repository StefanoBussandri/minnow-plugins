{
  "apiVersion": 1,
  "id": "sql-console",
  "name": "SQL Console",
  "version": "1.3.1",
  "description": "Browse schemas, run read-only-by-default queries and keep named SQL snippets for PostgreSQL, MySQL and SQLite. SQLite uses Node's built-in driver; PostgreSQL and MySQL use the psql/mysql clients already on your PATH.",
  "tools": [
    {
      "id": "sql_test_connection",
      "description": "Verify the configured database connection and return the server version.",
      "handler": "sql_test_connection.mjs",
      "parameters": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "id": "sql_list_schemas",
      "description": "List schemas (PostgreSQL/MySQL) or attached databases (SQLite).",
      "handler": "sql_list_schemas.mjs",
      "parameters": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "id": "sql_list_tables",
      "description": "List tables and views for a schema, with row counts where cheap.",
      "handler": "sql_list_tables.mjs",
      "parameters": {
        "type": "object",
        "properties": {
          "schema": {
            "type": "string",
            "description": "Schema or database name. SQLite defaults to \"main\"; PostgreSQL to \"public\"; MySQL to the configured database."
          },
          "include_row_counts": {
            "type": "boolean",
            "description": "Include row counts where they are cheap (default true). SQLite counts exactly for up to 100 tables; PostgreSQL uses planner estimates; MySQL uses information_schema.TABLE_ROWS."
          }
        },
        "additionalProperties": false
      }
    },
    {
      "id": "sql_describe_table",
      "description": "Describe a table: columns, types, nullability, defaults, primary key, foreign keys and indexes.",
      "handler": "sql_describe_table.mjs",
      "parameters": {
        "type": "object",
        "properties": {
          "table": { "type": "string", "description": "Table or view name." },
          "schema": { "type": "string", "description": "Schema name; optional." }
        },
        "required": ["table"],
        "additionalProperties": false
      }
    },
    {
      "id": "sql_query",
      "description": "Run a SQL statement. Read-only by default: write statements (INSERT/UPDATE/DELETE/DDL) and multi-statement batches are refused unless allow_write is true. Results are truncated with an explicit marker when they exceed the result budget.",
      "handler": "sql_query.mjs",
      "timeoutMs": 120000,
      "parameters": {
        "type": "object",
        "properties": {
          "sql": { "type": "string", "description": "The SQL statement to run." },
          "allow_write": {
            "type": "boolean",
            "description": "Set true to allow non-read statements. Default false."
          },
          "row_limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5000,
            "description": "Maximum rows to return (default 200)."
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 120000,
            "description": "Client timeout for CLI dialects, in milliseconds (default 30000)."
          }
        },
        "required": ["sql"],
        "additionalProperties": false
      }
    },
    {
      "id": "sql_save_snippet",
      "description": "Create or update a named SQL snippet stored under the plugin data directory.",
      "handler": "sql_save_snippet.mjs",
      "parameters": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "description": "Snippet name; saving an existing name updates it." },
          "sql": { "type": "string", "description": "The SQL text." },
          "id": { "type": "string", "description": "Existing snippet id to update (optional)." }
        },
        "required": ["name", "sql"],
        "additionalProperties": false
      }
    },
    {
      "id": "sql_list_snippets",
      "description": "List saved SQL snippets, most recently updated first.",
      "handler": "sql_list_snippets.mjs",
      "parameters": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "id": "sql_delete_snippet",
      "description": "Delete a saved SQL snippet by id.",
      "handler": "sql_delete_snippet.mjs",
      "parameters": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "Snippet id from sql_list_snippets." }
        },
        "required": ["id"],
        "additionalProperties": false
      }
    }
  ],
  "connections": [
    {
      "id": "database",
      "label": "Database",
      "fields": [
        { "id": "dialect", "label": "Dialect (postgres | mysql | sqlite)", "secret": false, "required": true },
        { "id": "file", "label": "SQLite file path (sqlite only)", "secret": false, "required": false },
        { "id": "host", "label": "Host (postgres/mysql)", "secret": false, "required": false },
        { "id": "port", "label": "Port (postgres/mysql)", "secret": false, "required": false },
        { "id": "database", "label": "Database name (postgres/mysql)", "secret": false, "required": false },
        { "id": "user", "label": "User (postgres/mysql)", "secret": false, "required": false },
        { "id": "password", "label": "Password (postgres/mysql)", "secret": true, "required": false },
        { "id": "ssl_mode", "label": "SSL mode (postgres | mysql)", "secret": false, "required": false }
      ]
    }
  ],
  "ui": { "entry": "ui.mjs" }
}
